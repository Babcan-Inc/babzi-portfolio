# Admin login (required for /admin)
ADMIN_PASSWORD=

# Optional HMAC secret for session cookies (defaults to ADMIN_PASSWORD)
ADMIN_SECRET=

# Production persistence on Vercel: commit content/writing.json via GitHub Contents API.
# Without GITHUB_TOKEN, admin saves only hit the ephemeral local filesystem.
GITHUB_TOKEN=
GITHUB_REPO=Babcan-Inc/babzi-portfolio
GITHUB_BRANCH=main
